{
  "functions": {
    "api/serve.js": {
      "includeFiles": "protected/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/login.html", "destination": "/login.html" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/api/serve" }
  ]
}
